{
  "gerrit": {
    "url": "https://gerrit.example.com",
    "username": "archiver-bot",
    "git_url": "https://gerrit.example.com/a"
  },
  "ledger_path": "/var/lib/gerrit-github-archiver/ledger.sqlite3",
  "mirror_path": "/var/lib/gerrit-github-archiver/mirrors",
  "lookback_minutes": 180,
  "poll_interval_seconds": 60,
  "skip_autogenerated_messages": true,
  "projects": [
    {
      "gerrit_project": "myproject",
      "branches": ["main"],
      "branch_prefix": "gerrit-archive",
      "github": {
        "owner": "myorg",
        "repo": "myproject"
      }
    }
  ]
}
