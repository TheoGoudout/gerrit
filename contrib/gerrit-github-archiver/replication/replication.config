; Layer A and Layer B of the Gerrit -> GitHub archive.
;
; Install as $site_path/etc/replication.config and put the matching
; credentials in $site_path/etc/secure.config (see secure.config.example).
;
; Replace myorg / myorg-archive / myproject throughout.
;
; WARNING: if $site_path/etc/replication/ exists as a directory, every remote
; section in THIS file is ignored. Use one or the other, never both.

[gerrit]
	; Pick up edits to this file without restarting the plugin. Pending
	; events scheduled under the old settings are discarded on reload.
	autoReload = true
	replicateOnStartup = true

[replication]
	maxRetries = 10
	lockErrorMaxRetries = 5

; ---------------------------------------------------------------------------
; Layer A: the read-only GitHub mirror.
;
; Branches and tags only. This is the repository people browse, and the one
; the archiver opens its pull requests against.
; ---------------------------------------------------------------------------
[remote "github-mirror"]
	url = https://github.com/myorg/${name}.git
	push = +refs/heads/*:refs/heads/*
	push = +refs/tags/*:refs/tags/*

	projects = myproject

	; CRITICAL: leave this false.
	;
	; mirror = true deletes remote refs that are absent locally, and the
	; refspec above covers all of refs/heads/*. The archiver pushes its
	; pull request heads to refs/heads/gerrit-archive/<change>, which do
	; not exist in Gerrit -- so mirror = true would delete them on the
	; next replication and break every archived pull request's diff.
	mirror = false

	; refs/meta/config holds the project ACLs. The refspec above already
	; excludes it; this is defence in depth for a public mirror.
	replicatePermissions = false

	; GitHub repositories cannot be created by pushing to them.
	createMissingRepositories = false

	; Delay before the push is scheduled, in seconds.
	;
	; This is deliberately longer than the archiver's poll interval. The
	; archiver wants to create the pull request BEFORE the merge commit
	; reaches the mirror's default branch: GitHub then sees the head
	; become reachable from the base and flips the PR to "Merged" on its
	; own. If replication wins the race, the archiver still records the
	; change, but the PR reads "Closed" and pins a synthetic base.
	;
	; Raising this makes the mirror lag by up to this many seconds, which
	; is acceptable for a read-only mirror.
	replicationDelay = 120

	threads = 2

	; Gerrit project names may contain "/", GitHub repository names may
	; not. "dash" maps platform/core -> platform-core.
	remoteNameStyle = dash

; ---------------------------------------------------------------------------
; Layer B, part 1: the lossless NoteDb archive of each project.
;
; refs/changes/* carries every patch set AND the per-change meta ref, which
; holds all comments, votes, reviewer changes and status transitions as JSON.
; This is the durable record; layer C is only a readable view of it.
;
; The destination MUST be a private repository.
; ---------------------------------------------------------------------------
[remote "github-archive"]
	url = https://github.com/myorg-archive/${name}.git

	; Patch set refs and change meta refs.
	push = +refs/changes/*:refs/changes/*
	; Branches and tags, so the archive is a self-contained clone.
	push = +refs/heads/*:refs/heads/*
	push = +refs/tags/*:refs/tags/*
	; Project ACLs and submit rules, as they stood.
	push = +refs/meta/config:refs/meta/config

	; Deliberately NOT replicated:
	;   refs/cache-automerge/*  regenerable cache, large, no archival value

	projects = myproject

	mirror = false
	replicatePermissions = true
	createMissingRepositories = false

	; Nothing reads this in a hurry; batch aggressively.
	replicationDelay = 900
	threads = 1

	remoteNameStyle = dash

	; Replication reads refs as this group. refs/changes/* and the meta
	; refs are only visible to a group holding "Access Database".
	; authGroup = Archive Readers

; ---------------------------------------------------------------------------
; Layer B, part 2: identity.
;
; NoteDb deliberately pseudonymises comment authors as "Gerrit User 1000042"
; (see ChangeNoteUtil.GERRIT_USER_TEMPLATE). Real names and emails live in
; All-Users under refs/users/*. Without this remote the archive above is
; complete but anonymous.
;
; The destination MUST be a private repository: this is personal data.
; ---------------------------------------------------------------------------
[remote "github-archive-allusers"]
	url = https://github.com/myorg-archive/all-users.git

	; Per-account config: full name, preferred email, account state.
	push = +refs/users/*:refs/users/*
	; Group membership, so reviewer groups resolve.
	push = +refs/groups/*:refs/groups/*
	push = +refs/meta/group-names:refs/meta/group-names

	; Deliberately NOT replicated:
	;   refs/draft-comments/*   UNPUBLISHED comments. Archiving these would
	;                           disclose private notes their authors never
	;                           published. Never add this refspec.
	;   refs/starred-changes/*  per-user UI state, no archival value.
	;
	; Optional, and off by default -- refs/meta/external-ids maps accounts
	; to every external identity (email addresses, usernames, OAuth
	; subjects). refs/users/* already carries the name and preferred email
	; that attribution needs, so enable this only if you specifically want
	; the full identity mapping:
	;   push = +refs/meta/external-ids:refs/meta/external-ids

	projects = All-Users

	mirror = false
	replicatePermissions = false
	createMissingRepositories = false

	replicationDelay = 900
	threads = 1

	; NOTE: refs/users/* also contains change edits
	; (refs/users/XX/YYYY/edit-<change>/<ps>) -- unpublished in-browser
	; edits. They are inseparable from account config at refspec
	; granularity. Acceptable for a private archive; be aware of it.
